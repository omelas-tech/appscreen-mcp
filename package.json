{
  "name": "@appscreen/mcp",
  "version": "0.28.3",
  "mcpName": "co.appscreen/mcp",
  "description": "MCP server for AppScreen — generate App Store / Play Store screenshots from agents.",
  "license": "MIT",
  "homepage": "https://appscreen.co/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omelas-tech/appscreen-mcp.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "appscreen-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "appscreen",
    "screenshots",
    "app-store",
    "play-store"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "env-paths": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "bugs": {
    "url": "https://github.com/omelas-tech/appscreen-mcp/issues"
  }
}
